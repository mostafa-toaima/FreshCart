{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"shell": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"standalone": false
				},
				"@schematics/angular:directive": {
					"standalone": false
				},
				"@schematics/angular:pipe": {
					"standalone": false
				}
			},
			"root": "projects/shell",
			"sourceRoot": "projects/shell/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ]
          },
					"configurations": {
						"production": {
							"target": "shell:esbuild:production"
						},
						"development": {
							"target": "shell:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "shell:serve-original:development",
						"rebuildDelay": 0,
						"dev": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ]
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/shell/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ],
						"styles": [
							"projects/shell/src/styles.scss",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "./node_modules/ngx-toastr/toastr.css",
              "./node_modules/ngx-spinner/animations/ball-zig-zag.css"
          ],
          "scripts": [
            "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
          ]
					}
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"browser": "projects/shell/src/main.ts",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "projects/shell/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ],
						"styles": [
							"projects/shell/src/styles.scss",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "./node_modules/ngx-toastr/toastr.css",
              "./node_modules/ngx-spinner/animations/ball-zig-zag.css"
          ],
          "scripts": [
            "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
          ]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "shell:esbuild:production"
						},
						"development": {
							"buildTarget": "shell:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200
					}
				}
			}
		},
		"products": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"standalone": false
				},
				"@schematics/angular:directive": {
					"standalone": false
				},
				"@schematics/angular:pipe": {
					"standalone": false
				}
			},
			"root": "projects/products",
			"sourceRoot": "projects/products/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "products:esbuild:production"
						},
						"development": {
							"target": "products:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "products:serve-original:development",
						"rebuildDelay": 0,
						"dev": true
}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/products/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/products/public"
							}
						],
						"styles": [
							"projects/products/src/styles.scss",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "./node_modules/ngx-toastr/toastr.css",
              "./node_modules/ngx-spinner/animations/ball-zig-zag.css"
						],
            "scripts": [
              "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
					}
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"browser": "projects/products/src/main.ts",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "projects/products/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/products/public"
							}
						],
						"styles": [
							"projects/products/src/styles.scss",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "./node_modules/ngx-toastr/toastr.css",
              "./node_modules/ngx-spinner/animations/ball-zig-zag.css"
          ],
          "scripts": [
            "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
          ]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "products:esbuild:production"
						},
						"development": {
							"buildTarget": "products:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4201
					}
				}
			}
		},
		"auth": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"standalone": false
				},
				"@schematics/angular:directive": {
					"standalone": false
				},
				"@schematics/angular:pipe": {
					"standalone": false
				}
			},
			"root": "projects/auth",
			"sourceRoot": "projects/auth/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shell/src",
                "projects/auth/src"
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ]
          },
					"configurations": {
						"production": {
							"target": "auth:esbuild:production"
						},
						"development": {
							"target": "auth:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "auth:serve-original:development",
						"rebuildDelay": 0,
						"dev": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ]
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/auth/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
              {
                "glob": "**/*",
                "input": "projects/shell/public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/shell/src/assets",
                "output": "/assets"
              }
            ],
						"styles": [
							"projects/auth/src/styles.scss",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "./node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "./node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "./node_modules/ngx-toastr/toastr.css",
              "./node_modules/ngx-spinner/animations/ball-zig-zag.css"
          ],
          "scripts": [
            "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
          ]
					}
				},
				"esbuild": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"browser": "projects/auth/src/main.ts",
						"polyfills": [
							"zone.js",
							"es-module-shims"
						],
						"tsConfig": "projects/auth/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
					"assets": [
            {
              "glob": "**/*",
              "input": "projects/shell/public",
              "output": "/"
            },
            {
              "glob": "**/*",
              "input": "projects/shell/src/assets",
              "output": "/assets"
            }
          ],
          "styles": [
            "projects/auth/src/styles.scss",
            "./node_modules/bootstrap/dist/css/bootstrap.min.css",
            "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
            "./node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
            "./node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
            "./node_modules/ngx-toastr/toastr.css",
            "./node_modules/ngx-spinner/animations/ball-zig-zag.css"
        ],
        "scripts": [
          "./node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
        ]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
